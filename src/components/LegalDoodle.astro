      <path class="ink fillp" d="M181 96C180 80 192 72 207 72C223 72 233 82 232 100C231 124 225 145 207 149C190 149 182 126 181 96Z"/>
      <!-- Bart -->
      <path style="fill:var(--beard)" d="M182 96C182 126 190 147 207 151C224 147 232 126 231 96C229 110 226 118 221 121C214 117 200 117 193 121C188 118 184 110 182 96Z"/>
