---
// Doodle der Seite "legal" (Datenschutz & Impressum, animierte SVG-Zeichnung). Ruhe: Zustand A, Hover/Tippen/Fokus: Zustand B.
// Gemeinsames CSS: src/styles/doodles.css
import "../styles/doodles.css";

export interface Props {
  alt: string;
}
const { alt } = Astro.props;
---

<div class="doodle doodle-sm doodle-legal" tabindex="0" role="img" aria-label={alt}>
<svg width="260" height="200" viewBox="93 -1 347 267" xmlns="http://www.w3.org/2000/svg"><defs><filter id="wobble-legal" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1"><animate attributeName="seed" values="1;2;3" dur="0.45s" calcMode="discrete" repeatCount="indefinite"/></feTurbulence><feDisplacementMap in="SourceGraphic" scale="2.2"/></filter></defs><g class="lines" filter="url(#wobble-legal)"><path class="ink" d="M110 263C200 260 320 265 430 262"/><path class="ink fillp" d="M244 250L400 244L402 262L246 262Z"/><path class="ink thin" stroke-width="1" d="M262 254h40M312 252h50M270 258h70"/><circle class="ink fillp" cx="404" cy="252" r="11"/><circle class="ink thin" cx="404" cy="252" r="4"/><!-- Oberkörper: dunkelgrüner Pulli -->
    <path class="ink" style="fill:var(--sweater)" d="M158 252C157 214 168 184 196 164L216 164C244 184 255 214 254 252Z"/>
