      <path fill="none" style="stroke:var(--hl)" stroke-opacity=".55" stroke-width="1.3" stroke-linecap="round" d="M190 70q12-9 26-6M198 75q12-4 24 1M184 82q2-10 8-16"/>
      <path class="ink thin" style="stroke:var(--outline)" d="M222 56c6-8 14-10 22-9M204 52c2-7 8-11 15-11M188 61c-5-4-7-10-5-15M239 66c5-1 9 2 11 6"/>
      <!-- Nase -->
      <path class="ink" d="M208 97C206 107 204 113 201 116q5 4 11 1"/>

      <g class="state-a"><path class="ink" stroke-width="3" d="M187 95l14 2M213 97l14-2"/><path class="ink" d="M190 104q5 4 10 0M214 104q5 4 10 0"/><path class="ink" d="M200 130q3-3 6 0t6 0"/></g><g class="state-b"><path class="ink" stroke-width="3" d="M187 92q7-5 14-1M212 91q7-4 14 1"/><ellipse class="ink fillp" cx="195" cy="104" rx="6.5" ry="3.6"/><circle cx="195.5" cy="104.2" r="2.6" style="fill:var(--iris)"/><circle cx="195.5" cy="104.2" r="1.2" style="fill:var(--pupil)"/><ellipse class="ink fillp" cx="219" cy="104" rx="6.5" ry="3.6"/><circle cx="219.5" cy="104.2" r="2.6" style="fill:var(--iris)"/><circle cx="219.5" cy="104.2" r="1.2" style="fill:var(--pupil)"/><path class="acc" d="M197 125Q207 138 219 125Q207 128 197 125Z"/><path style="fill:var(--teeth)" d="M198.5 125.6Q207 128.6 217.5 125.6Q208 131.5 198.5 125.6Z"/><path class="ink thin" d="M197 125Q207 138 219 125Q207 128 197 125Z"/></g></g></g><path class="ink fillp" d="M166 172L254 168L258 252L162 252Z"/><path class="ink" d="M178 182h40"/><path class="ink thin" stroke-width="1" d="M178 192h58M178 198h44M178 204h44M178 210h58M178 216h62M178 222h44M178 228h66M178 234h44M178 240h52"/><g class="state-b legal-stamp tb"><circle class="acc" cx="236" cy="232" r="11"/><path class="ink" d="M230 232l4 4 8-9"/></g><g class="legal-shield tb"><path class="ink fillp" d="M370 40L402 53C402 88 392 108 370 122C348 108 338 88 338 53Z"/><path class="ink legal-shackle tb" d="M362 82V73A8 8 0 0 1 378 73V82"/><rect class="acc" x="357" y="81" width="26" height="21" rx="3"/><rect class="ink" x="357" y="81" width="26" height="21" rx="3"/><path class="ink" d="M370 88v6"/><g class="state-b"><path class="accs" d="M392 64l7-7M396 78h9M348 64l-7-7M335 78h-9"/></g></g></g></svg>
