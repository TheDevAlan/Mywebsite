---
// Startseiten-Doodle "am Schreibtisch" (animierte SVG-Zeichnung, geliefert als doodle-schreibtisch.html).
// Idle: tippt und wippt. Hover, Fokus oder Antippen: schaut hoch und winkt.
// Farben: Hellmodus ist Standard, Dunkelmodus kommt über data-theme="dark" am <html> (ThemeScript).
export interface Props {
  alt: string;
}
const { alt } = Astro.props;
---

<div class="desk" tabindex="0" role="img" aria-label={alt}>
  <svg width="400" height="320" viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Handgezeichnetes "Zittern" der Linien -->
    <filter id="dd-wobble" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1">
        <animate attributeName="seed" values="1;2;3" dur="0.45s" calcMode="discrete" repeatCount="indefinite"/>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="2.2"/>
    </filter>
  </defs>

  <g class="lines" filter="url(#dd-wobble)">

    <!-- Code-Zeichen -->
    <g class="floats">
    <g class="floaty tb"><path class="ink thin" d="M112 70c-6 0-6 4-6 8v6c0 3-2 5-5 5c3 0 5 2 5 5v6c0 4 0 8 6 8"/>
      <path class="ink thin" d="M126 70c6 0 6 4 6 8v6c0 3 2 5 5 5c-3 0-5 2-5 5v6c0 4 0 8-6 8"/></g>
    <g class="floaty b tb"><path class="accs" d="M292 64l-8 8 8 8M310 64l8 8-8 8M304 60l-6 24"/></g>
    <g class="floaty c tb"><path class="ink thin" d="M150 52v14M156 52c6 0 6 14 0 14c-6 0-6-14 0-14"/></g>
    </g>

    <!-- Oberkörper: dunkelgrüner Pulli -->
    <path class="ink" style="fill:var(--sweater)" d="M158 252C157 214 168 184 196 164L216 164C244 184 255 214 254 252Z"/>
    <path class="ink" style="fill:var(--sweater)" d="M194 163Q206 178 218 163"/>
    <path fill="none" style="stroke:var(--hl)" stroke-opacity=".45" stroke-width="1.2" stroke-linecap="round" d="M197 166q9 8 18 0M174 214q5-9 12-14M240 202q3 6 4 12"/>

    <!-- Hals -->
    <g class="skin-part"><path style="fill:var(--skin)" d="M199 140L198 164L215 164L214 140Z"/><path class="ink" d="M199 142L198 163M214 142L215 163"/></g>

    <!-- Kopf -->
    <g class="head-pose tb"><g class="head-bob tb skin-part">
      <!-- Ohren -->
      <path class="ink fillp" d="M182 100c-8-4-11 12-1 16M231 100c8-4 11 12 1 16"/>
      <!-- Gesicht (etwas länger, schmales Kinn) -->
      <path class="ink fillp" d="M181 96C180 80 192 72 207 72C223 72 233 82 232 100C231 124 225 145 207 149C190 149 182 126 181 96Z"/>
      <!-- Bart -->
      <path style="fill:var(--beard)" d="M182 96C182 126 190 147 207 151C224 147 232 126 231 96C229 110 226 118 221 121C214 117 200 117 193 121C188 118 184 110 182 96Z"/>
      <clipPath id="dd-beard-clip"><path d="M182 96C182 126 190 147 207 151C224 147 232 126 231 96C229 110 226 118 221 121C214 117 200 117 193 121C188 118 184 110 182 96Z"/></clipPath><path clip-path="url(#dd-beard-clip)" style="stroke:var(--stache)" fill="none" stroke-width="1.2" stroke-linecap="round" d="M183.1 103.1l-1.2 3M187.5 104.8l-0.9 3M223.4 104.2l0.8 3M228.1 104.9l1.1 3M184.6 107.5l-1.1 3M189.2 107.1l-0.9 3M223.9 108.4l0.9 3M226.9 108.5l1.0 3M184.4 113.2l-1.1 3M188.8 111.5l-0.9 3M224.8 112.9l0.9 3M227.5 111.8l1.0 3M183.7 116.9l-1.1 3M189.1 115.2l-0.9 3M207.7 116.2l0.1 3M213.1 116.5l0.3 3M216.0 116.3l0.5 3M225.0 116.7l0.9 3M228.9 116.7l1.1 3M183.7 119.8l-1.1 3M187.0 120.3l-1.0 3M190.9 119.0l-0.8 3M195.3 119.2l-0.6 3M199.6 118.9l-0.3 3M202.8 119.2l-0.2 3M207.0 119.7l0.0 3M216.3 119.2l0.5 3M219.4 119.6l0.6 3M223.7 119.1l0.9 3M228.8 121.2l1.1 3M183.9 124.0l-1.1 3M187.0 123.0l-1.0 3M191.6 123.4l-0.7 3M219.4 123.7l0.6 3M223.2 124.7l0.8 3M228.1 124.7l1.1 3M188.7 129.2l-0.9 3M192.8 128.7l-0.7 3M221.0 129.2l0.7 3M225.1 127.7l0.9 3M192.8 132.0l-0.7 3M221.1 131.8l0.7 3M197.2 136.4l-0.5 3M199.6 136.1l-0.3 3M203.1 134.8l-0.2 3M209.1 136.4l0.1 3M212.1 137.0l0.3 3M215.8 136.9l0.5 3M220.8 135.3l0.7 3M196.2 141.0l-0.5 3M199.8 141.0l-0.3 3M204.0 140.1l-0.1 3M208.1 138.8l0.1 3M211.9 139.2l0.3 3M214.8 140.7l0.4 3M219.2 139.9l0.6 3M196.7 144.0l-0.5 3M200.1 144.6l-0.3 3M205.0 143.9l-0.1 3M208.3 144.0l0.1 3M212.0 144.5l0.3 3M215.9 144.1l0.5 3M199.0 148.4l-0.4 3M204.7 149.0l-0.1 3M207.2 148.5l0.0 3M212.4 147.1l0.3 3"/>
      
      <!-- Haare: voll, verwuschelt, Pony zur Seite -->
      <path class="ink" style="fill:var(--hair);stroke:var(--outline)" d="M180 98C172 84 172 68 186 58C196 48 214 46 228 53C236 56 244 52 249 47C247 57 243 61 241 64C247 72 245 82 236 89C233 84 230 81 225 79C214 84 200 85 190 81C186 84 184 90 182 98Z"/>
      <path fill="none" style="stroke:var(--hl)" stroke-opacity=".55" stroke-width="1.3" stroke-linecap="round" d="M190 70q12-9 26-6M198 75q12-4 24 1M184 82q2-10 8-16"/>
      <path class="ink thin" style="stroke:var(--outline)" d="M222 56c6-8 14-10 22-9M204 52c2-7 8-11 15-11M188 61c-5-4-7-10-5-15M239 66c5-1 9 2 11 6"/>
      <!-- Nase -->
      <path class="ink" d="M208 97C206 107 204 113 201 116q5 4 11 1"/>

      <!-- Gesicht: konzentriert -->
      <g class="eyes-down">
        <path class="ink" stroke-width="3" d="M187 95l14 2M213 97l14-2"/>
        <path class="ink" d="M190 104q5 4 10 0M214 104q5 4 10 0"/>
        <path class="ink" d="M201 129h10"/>
        <path class="acc" d="M210 129q5 1 4 5q-4 1-5-4z"/>
      </g>
      <!-- Gesicht: schaut hoch, grinst -->
      <g class="eyes-up">
        <path class="ink" stroke-width="3" d="M187 92q7-5 14-1M212 91q7-4 14 1"/>
        <ellipse class="ink fillp" cx="195" cy="104" rx="6.5" ry="3.6"/><circle cx="195.5" cy="104" r="2.6" style="fill:var(--iris)"/><circle cx="195.5" cy="104" r="1.2" style="fill:var(--pupil)"/>
        <ellipse class="ink fillp" cx="219" cy="104" rx="6.5" ry="3.6"/><circle cx="219.5" cy="104" r="2.6" style="fill:var(--iris)"/><circle cx="219.5" cy="104" r="1.2" style="fill:var(--pupil)"/>
        <path class="acc" d="M197 125Q207 138 219 125Q207 128 197 125Z"/>
        <path style="fill:var(--teeth)" d="M198.5 125.6Q207 128.6 217.5 125.6Q208 131.5 198.5 125.6Z"/>
        <path class="ink thin" d="M197 125Q207 138 219 125Q207 128 197 125Z"/>
      </g>
    </g></g>

    <!-- Tippende Arme (Falten im Ärmel) -->
    <g class="type-arm tb"><path fill="none" style="stroke:var(--hl)" stroke-opacity=".55" stroke-width="1.6" stroke-linecap="round" d="M168 210C168 228 172 238 182 243"/></g>
    <g class="type-arm r tb"><path fill="none" style="stroke:var(--hl)" stroke-opacity=".55" stroke-width="1.6" stroke-linecap="round" d="M244 210C244 228 240 238 230 243"/></g>

    <!-- Winkender Arm -->
    <g class="wave-arm tb">
      <path d="M244 198Q294 200 302 160" fill="none" style="stroke:var(--ink)" stroke-width="15" stroke-linecap="round"/>
      <path d="M244 198Q294 200 302 160" fill="none" style="stroke:var(--sweater)" stroke-width="10" stroke-linecap="round"/>
      <g class="forearm tb">
        <path d="M302 160L305 128" fill="none" style="stroke:var(--ink)" stroke-width="14" stroke-linecap="round"/>
        <path d="M302 160L305 128" fill="none" style="stroke:var(--sweater)" stroke-width="9" stroke-linecap="round"/>
        <path d="M300 106l-2-10M305 104l0-11M310 105l2-10M296 114l-8-5" fill="none" style="stroke:var(--outline)" stroke-width="5.5" stroke-linecap="round"/>
        <path d="M300 106l-2-10M305 104l0-11M310 105l2-10M296 114l-8-5" fill="none" style="stroke:var(--skin)" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="305" cy="114" r="10" style="fill:var(--skin);stroke:var(--outline)" stroke-width="2.4"/>
        <path class="accs" d="M324 100q6 10 0 20M332 96q8 14 0 28"/>
      </g>
    </g>

    <!-- Laptop (Rückseite) -->
    <path class="ink fillp" d="M158 196L254 193L257 248L156 248Z"/>
    <circle class="acc" cx="206" cy="221" r="13"/>
    <path class="ink thin" d="M200 216l-5 5 5 5M212 216l5 5-5 5M209 213l-5 16"/>

    <!-- Tisch -->
    <path class="ink" d="M20 252C120 249 280 254 380 251"/>
    <path class="ink" d="M24 261C130 258 270 263 376 260"/>
    <path class="ink thin" d="M60 266l-4 8M90 266l-4 8M120 266l-4 8M290 266l-4 8M320 266l-4 8M350 266l-4 8"/>
    <path class="ink" d="M42 261L40 312M358 260L361 312"/>

    <!-- Tasse -->
    <path class="ink fillp" d="M70 218L73 251L100 251L103 218Z"/>
    <path class="acc" d="M71.5 228L102 228L101.3 237L72.3 237Z"/>
    <path class="ink" d="M103 226c11 0 11 15-1 15"/>
    <path class="ink thin steam" d="M80 210c-6-8 6-14 0-24M92 210c-6-8 6-14 0-24"/>
  </g>
</svg>
</div>

<style>
  /* Farben – Hellmodus (Standard) */
  .desk {
    --ink: #1f1c18;
    --paper: #fbfaf7;
    --accent: #d9604a;
    --sweater: #34493f;
    --hair: #3a2e26;
    --beard: #8b705a;
    --stache: #5e4838;
    --hl: #fbfaf7;
    --teeth: #ffffff;
    --iris: #4f86c6;
    --pupil: #1f1c18;
    --skin: #fbfaf7;
    --face-ink: #1f1c18;
    width: 400px;
    max-width: 100%;
    aspect-ratio: 400 / 320;
    display: block;
    cursor: pointer;
    outline: none;
  }
  /* Dunkelmodus: ThemeScript setzt data-theme="dark" am <html> */
  :global([data-theme='dark']) .desk {
    --ink: #efe9de;
    --paper: #1b1a18;
    --accent: #f2876f;
    --sweater: #2c4238;
    --hair: #4a3b30;
    --beard: #8b705a;
    --stache: #5e4838;
    --hl: #efe9de;
    --teeth: #ffffff;
    --iris: #4f86c6;
    --skin: #ece4d6;
    --face-ink: #1b1a18;
  }
  .desk:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  svg {
    --outline: var(--ink);
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  /* Haut (Gesicht, Hals, Hand): eigene Fläche und dunkle Linien, auch im Dunkelmodus */
  .skin-part {
    --ink: var(--face-ink);
    --paper: var(--skin);
  }

  .ink {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thin {
    stroke-width: 1.3;
  }
  .fillp {
    fill: var(--paper);
  }
  .acc {
    fill: var(--accent);
  }
  .accs {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .tb {
    transform-box: view-box;
  }

  /* Kopf: Pose (Hover-Übergang) und Wippen (Idle) */
  .head-pose {
    transform-origin: 206px 146px;
    transform: translate(0, 7px) rotate(7deg);
    transition: transform 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .head-bob {
    transform-origin: 206px 146px;
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: rotate(2deg) translateY(1.5px);
    }
  }

  .eyes-up,
  .wave-arm {
    opacity: 0;
  }
  .eyes-down,
  .eyes-up,
  .type-arm,
  .floats {
    transition: opacity 0.25s;
  }

  /* Tippende Arme */
  .type-arm {
    transform-origin: 206px 240px;
    animation: type 0.28s steps(2) infinite;
  }
  @keyframes type {
    50% {
      transform: translateY(-1.5px);
    }
  }

  /* Winkender Arm */
  .wave-arm {
    transform-origin: 244px 198px;
    transform: rotate(70deg);
    transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1), opacity 0.2s;
  }
  .forearm {
    transform-origin: 302px 160px;
  }

  /* Code-Zeichen, die aufsteigen */
  .floaty {
    animation: float 3.2s ease-in infinite;
  }
  .floaty.b {
    animation-delay: 1.1s;
  }
  .floaty.c {
    animation-delay: 2.2s;
  }
  @keyframes float {
    0% {
      transform: translateY(12px);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: translateY(-28px);
      opacity: 0;
    }
  }

  /* Dampf */
  .steam {
    stroke-dasharray: 6 5;
    animation: steam 1.2s linear infinite;
  }
  @keyframes steam {
    to {
      stroke-dashoffset: -22;
    }
  }

  /* Hover, Tippen, Tastatur-Fokus */
  .desk:hover .head-pose,
  .desk:focus .head-pose {
    transform: translate(0, -4px) rotate(-3deg);
  }
  .desk:hover .head-bob,
  .desk:focus .head-bob {
    animation: none;
  }
  .desk:hover .eyes-down,
  .desk:focus .eyes-down {
    opacity: 0;
  }
  .desk:hover .eyes-up,
  .desk:focus .eyes-up {
    opacity: 1;
  }
  .desk:hover .type-arm.r,
  .desk:focus .type-arm.r {
    opacity: 0;
  }
  .desk:hover .type-arm,
  .desk:focus .type-arm {
    animation-play-state: paused;
  }
  .desk:hover .floats,
  .desk:focus .floats {
    opacity: 0;
  }
  .desk:hover .wave-arm,
  .desk:focus .wave-arm {
    opacity: 1;
    transform: rotate(0);
  }
  .desk:hover .forearm,
  .desk:focus .forearm {
    animation: wave 0.38s ease-in-out 0.35s infinite alternate;
  }
  @keyframes wave {
    from {
      transform: rotate(-14deg);
    }
    to {
      transform: rotate(16deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .desk :global(*) {
      animation: none !important;
      transition: opacity 0.2s !important;
    }
    .lines {
      filter: none;
    }
  }
</style>
