---
// Linke Spalte: Logo, Navigation, Sprach- und Theme-Umschalter, Footer.
// Maße und Schriften: planung/design-handoff/README.md, Abschnitt "Globales Layout".
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { localePath, switchLangPath } from '../i18n/utils';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  active?: 'about' | 'works' | 'thoughts' | 'contact';
  sticky?: boolean;
  lang?: Lang;
}

const { active, sticky = false, lang = 'de' } = Astro.props;
const t = useTranslations(lang);

// Navigationsbegriffe bleiben in beiden Sprachen englisch
const nav = [
  { id: 'about', href: localePath('/about', lang) },
  { id: 'works', href: localePath('/works', lang) },
  { id: 'thoughts', href: localePath('/thoughts', lang) },
  { id: 'contact', href: localePath('/contact', lang) },
] as const;
const langLinks = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code],
  href: switchLangPath(Astro.url.pathname, code),
  current: code === lang,
}));
---

<aside class:list={['sidebar', { sticky }]}>
  <a class="logo" href={localePath('/', lang)} aria-label={t('sidebar.home')}>alan<span class="dot">.</span></a>

  <nav class="nav" aria-label={t('sidebar.navLabel')}>
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[{ current: active === item.id }]}
          aria-current={active === item.id ? 'page' : undefined}
        >
          {item.id}
        </a>
      ))
    }
  </nav>

  <div class="switch lang" role="group" aria-label={t('sidebar.langLabel')}>
    {
      langLinks.map((l, i) => (
        <>
          {i > 0 && <span class="slash">/</span>}
          {l.current ? (
            <span class="on" aria-current="true">
              {l.label}
            </span>
          ) : (
            <a class="off" href={l.href} hreflang={l.code} lang={l.code}>
              {l.label}
            </a>
          )}
        </>
      ))
    }
  </div>

  <div class="switch theme">
    <button type="button" class="theme-btn sun" data-set-theme="light" aria-label="hell">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
        ></path></svg
      >
    </button>
    <span class="slash">/</span>
    <button type="button" class="theme-btn moon" data-set-theme="dark" aria-label="dunkel">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"
        ><path d="M19.5 14.8A8 8 0 0 1 9.2 4.5 8 8 0 1 0 19.5 14.8Z"></path></svg
      >
    </button>
  </div>

  <div class="side-foot">
    <SiteFooter lang={lang} />
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.setTheme;
      if (theme === 'light' || theme === 'dark') (window as any).setTheme?.(theme);
    });
  });
</script>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    padding: 64px 0 40px 72px;
    font-family: var(--font-display);
    line-height: normal; /* wie im Prototyp, nicht der geerbte Tailwind-Wert 1.5 */
    min-height: 100vh;
    box-sizing: border-box;
  }
  .sidebar.sticky {
    position: sticky;
    top: 0;
    align-self: start;
  }

  .logo {
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s;
  }
  .logo .dot {
    color: var(--coral);
    transition: color 0.2s;
  }
  .logo:hover {
    color: var(--coral);
  }
  .logo:hover .dot {
    color: var(--ink);
  }

  .nav {
    margin-top: 72px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 30px;
    font-weight: 400;
  }
  .nav a {
    color: var(--ink);
    text-decoration: none;
    width: fit-content;
    transition: color 0.2s;
  }
  .nav a:hover {
    color: var(--coral);
  }
  .nav a.current {
    text-decoration: underline wavy var(--coral);
    text-underline-offset: 6px;
  }

  .switch {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    margin-top: 44px;
    font-size: 22px;
  }
  .lang .on {
    font-weight: 700;
    color: var(--ink);
  }
  .lang .off {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .lang a.off:hover {
    color: var(--coral);
  }
  .slash {
    color: var(--muted2);
  }
  .theme {
    margin-top: 14px;
    font-size: 22px;
  }

  .theme-btn {
    background: none;
    border: none;
    padding: 2px;
    display: inline-flex;
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }
  .theme-btn:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .sun:hover {
    transform: rotate(20deg);
  }
  .moon:hover {
    transform: rotate(-15deg);
  }
  /* Aktives Icon = aktuelles Theme (rein per CSS, kein Skript-Zustand) */
  :global([data-theme='light']) .sun,
  :global([data-theme='dark']) .moon {
    color: var(--ink);
  }

  .side-foot {
    margin-top: auto;
    padding-top: 40px;
  }

  /* Mobil (Vorschlag aus planung/design-handoff/README.md, Responsive):
     Sidebar wird zur Leiste oben. Logo links, DE/EN und Theme rechts, Navigation als Zeile darunter.
     Die Fußzeile steht mobil am Seitenende (BaseLayout), nicht in der Leiste. */
  @media (max-width: 800px) {
    .sidebar {
      display: grid;
      grid-template-columns: 1fr auto auto;
      grid-template-areas:
        'logo lang theme'
        'nav nav nav';
      align-items: center;
      column-gap: 14px;
      min-height: auto;
      padding: 8px 20px 0;
    }
    .sidebar.sticky {
      position: static;
    }
    .logo {
      grid-area: logo;
      font-size: 40px;
    }
    .nav {
      grid-area: nav;
      margin-top: 0;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 18px;
      font-size: 22px;
    }
    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .lang {
      grid-area: lang;
      margin-top: 0;
      font-size: 20px;
      gap: 4px;
    }
    .lang .on,
    .lang .off {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 4px;
    }
    .theme {
      grid-area: theme;
      margin-top: 0;
      gap: 0;
    }
    .theme-btn {
      min-width: 44px;
      min-height: 44px;
      align-items: center;
      justify-content: center;
    }
    .theme .slash {
      display: none;
    }
    .side-foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-btn {
      transition: color 0.2s;
    }
    .sun:hover,
    .moon:hover {
      transform: none;
    }
  }
</style>
