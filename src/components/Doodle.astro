---
// Doodle mit zwei Zuständen A/B (Klick wechselt, Zustand nur lokal).
// Solange keine Zeichnung in public/doodles/ liegt, erscheint der Platzhalter aus
// planung/design-handoff/README.md ("Doodle-Komponente"). Namensschema für echte Bilder:
// public/doodles/{name}-a.svg|png und {name}-b.svg|png (name: home, about, thoughts, contact).
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  name: string;
  labelA: string;
  labelB: string;
  width?: number;
  height?: number;
  /** Grunddrehung in Grad */
  rotate?: number;
  /** Drehung beim Hover in Grad */
  hoverRotate?: number;
  hoverScale?: number;
}

const { name, labelA, labelB, width = 400, height = 320, rotate = 2, hoverRotate = -1.5, hoverScale = 1.02 } = Astro.props;

function findImage(state: 'a' | 'b'): string | undefined {
  for (const ext of ['svg', 'png']) {
    const file = `${name}-${state}.${ext}`;
    if (fs.existsSync(path.join(process.cwd(), 'public', 'doodles', file))) return `/doodles/${file}`;
  }
  return undefined;
}

const imgA = findImage('a');
const imgB = findImage('b');
const hasImages = Boolean(imgA && imgB);
---

<button
  type="button"
  class:list={['doodle', { placeholder: !hasImages }]}
  data-doodle
  data-label-a={labelA}
  data-label-b={labelB}
  data-img-a={imgA}
  data-img-b={imgB}
  style={`--w:${width}px;--h:${height}px;--r:${rotate}deg;--hr:${hoverRotate}deg;--hs:${hoverScale}`}
>
  {hasImages && <img src={imgA} alt="" />}
  <span class:list={['label', { sr: hasImages }]} aria-live="polite">{labelA}</span>
</button>

<script>
  // Zustand A/B nur lokal im Element, nichts wird gespeichert
  document.querySelectorAll<HTMLButtonElement>('[data-doodle]').forEach((btn) => {
    let showB = false;
    btn.addEventListener('click', () => {
      showB = !showB;
      const label = btn.querySelector<HTMLElement>('.label');
      const img = btn.querySelector<HTMLImageElement>('img');
      if (label) label.textContent = showB ? btn.dataset.labelB! : btn.dataset.labelA!;
      const src = showB ? btn.dataset.imgB : btn.dataset.imgA;
      if (img && src) img.src = src;
      btn.dataset.state = showB ? 'b' : 'a';
    });
  });
</script>

<style>
  .doodle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--w);
    height: var(--h);
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transform: rotate(var(--r));
    transition: transform 0.25s;
  }
  .doodle:hover {
    transform: rotate(var(--hr)) scale(var(--hs));
  }
  .doodle:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 6px;
  }

  .placeholder {
    border: 2px dashed var(--ink);
    border-radius: 8px 16px 10px 14px;
    background: repeating-linear-gradient(135deg, var(--stripe) 0 10px, var(--bg) 10px 20px);
    padding: 20px;
    box-sizing: border-box;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    text-align: center;
    white-space: pre-line;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
