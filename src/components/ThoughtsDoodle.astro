      <path class="ink" d="M208 97C206 107 204 113 201 116q5 4 11 1"/>

      <g class="state-a"><path class="ink" stroke-width="3" d="M187 94q7-2 14 0M212 89q7-5 14 0"/><circle class="ink fillp" cx="195" cy="104" r="5.5"/><circle cx="197.5" cy="101.5" r="3" style="fill:var(--iris)"/><circle cx="197.5" cy="101.5" r="1.4" style="fill:var(--pupil)"/><circle class="ink fillp" cx="219" cy="104" r="5.5"/><circle cx="221.5" cy="101.5" r="3" style="fill:var(--iris)"/><circle cx="221.5" cy="101.5" r="1.4" style="fill:var(--pupil)"/><path class="ink" d="M200 130q3-3 6 0t6 0"/></g><g class="state-b"><path class="ink" stroke-width="3" d="M187 89q7-5 14-1M212 88q7-5 14 1"/><circle class="ink fillp" cx="195" cy="104" r="5.5"/><circle cx="197" cy="102" r="3" style="fill:var(--iris)"/><circle cx="197" cy="102" r="1.4" style="fill:var(--pupil)"/><circle class="ink fillp" cx="219" cy="104" r="5.5"/><circle cx="221" cy="102" r="3" style="fill:var(--iris)"/><circle cx="221" cy="102" r="1.4" style="fill:var(--pupil)"/><path class="acc" d="M197 125Q207 138 219 125Q207 128 197 125Z"/><path style="fill:var(--teeth)" d="M198.5 125.6Q207 128.6 217.5 125.6Q208 131.5 198.5 125.6Z"/><path class="ink thin" d="M197 125Q207 138 219 125Q207 128 197 125Z"/></g></g></g><g class="tb"><path d="M242 198Q252 226 238 244Q228 206 224 166" fill="none" style="stroke:var(--outline)" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"/><path d="M242 198Q252 226 238 244Q228 206 224 166" fill="none" style="stroke:var(--sweater)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/><circle cx="221" cy="154" r="9" style="fill:var(--skin);stroke:var(--outline)" stroke-width="2.4"/><path class="ink thin" style="stroke:var(--outline)" d="M214 150q-3-4 0-8M218 146q-3-4 0-8"/></g><g class="thoughts-cloud tb"><circle class="ink fillp" cx="262" cy="92" r="3.5"/><circle class="ink fillp" cx="282" cy="80" r="5.5"/><path class="ink fillp" d="M310 70C296 56 310 32 332 40C338 20 372 16 384 34C402 24 428 40 420 60C438 74 420 100 400 92C390 108 358 108 350 94C330 104 304 92 310 70Z"/><g class="state-a"><path class="ink fillp" d="M357 78C357 70 351 67 351 58C351 49 358 44 365 44C372 44 379 49 379 58C379 67 373 70 373 78Z"/></g><g class="state-b thoughts-bulb"><path class="ink acc" style="stroke:var(--ink)" d="M357 78C357 70 351 67 351 58C351 49 358 44 365 44C372 44 379 49 379 58C379 67 373 70 373 78Z"/><path class="accs" d="M365 36v-8M347 42l-6-6M383 42l6-6M341 60h-8M389 60h8"/></g><path class="ink thin" d="M361 70l2-6 2 4 2-4 2 6"/><path class="ink" d="M358 82h14M359 86h12M362 90h6"/></g></g></svg>
