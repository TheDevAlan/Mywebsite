      <path class="ink thin" d="M186 118l1 2M189 126l1 2M193 134l1 2M199 140l1 2M206 143l0 2M213 140l-1 2M219 134l-1 2M224 126l-1 2M227 118l-1 2M196 130l1 1M203 136l0 2M211 135l-1 2M217 128l-1 1M191 112l0 2M222 112l0 2"/>
      <path class="ink" style="fill:var(--stache)" stroke-width="1" d="M195 123Q207 115 219 123Q207 120 195 123Z"/>
      <!-- Haare: voll, verwuschelt, Pony zur Seite -->
      <path class="ink" style="fill:var(--hair);stroke:var(--outline)" d="M180 106C172 88 172 70 186 60C196 50 214 48 228 55C236 58 244 54 249 49C247 59 243 63 241 66C247 74 245 90 236 102C234 93 231 86 225 83C214 89 200 90 190 85C186 91 184 99 183 107Z"/>
