---
// Seite "thoughts" (6d), Liste. Routen: src/pages/thoughts/index.astro (de), src/pages/en/thoughts/index.astro (en)
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import PageShell from "../components/PageShell.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import { localePath } from "../i18n/utils";
import { getPosts, formatMonth } from "../lib/posts";

export interface Props {
  lang?: Lang;
}
const { lang = "de" } = Astro.props;
const t = useTranslations(lang);
const posts = getPosts(lang);
---

<BaseLayout lang={lang} active="thoughts" bare>
  <PageShell wide>
    <Fragment slot="doodle">
      <Doodle
        name="thoughts"
        labelA={t("thoughts.doodleA")}
        labelB={t("thoughts.doodleB")}
        width={260}
        height={200}
        rotate={-3}
        hoverRotate={2}
        hoverScale={1.03}
      />
    </Fragment>
    <div class="thoughts">
    <header>
      <div class="head">
        <h1>{t("thoughts.title")}.</h1>
        <p class="sub">{t("thoughts.sub")}</p>
      </div>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">{t("thoughts.empty")}</p>
      ) : (
        <ul>
          {posts.map((post) => (
            <li>
              <a href={localePath(`/thoughts/${post.slug}`, lang)}>
                <time class="date" datetime={post.pubDate.toISOString()}>
                  {formatMonth(post.pubDate, lang)}
                </time>
                <span class="body">
                  <span class="title">{post.title}</span>
                  <span class="teaser">{post.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    </div>
  </PageShell>
</BaseLayout>

<style>
  .thoughts {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
  }
  .sub {
    margin: 0;
    max-width: 360px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text2);
  }
  .empty {
    margin: 0;
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    padding: 22px 0;
    border-top: 1.5px dashed var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s;
  }
  li a:hover {
    transform: translateX(8px);
  }
  .date {
    padding-top: 4px;
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--coral-d);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
  }
  .teaser {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .thoughts {
      gap: 28px;
    }
    h1 {
      font-size: 44px;
    }
    li a {
      grid-template-columns: 84px 1fr;
      gap: 14px;
    }
    .title {
      font-size: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li a {
      transition: none;
    }
    li a:hover {
      transform: none;
    }
  }
</style>
