---
// Seite "about" (6b). Routen: src/pages/about.astro (de), src/pages/en/about.astro (en)
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import PageShell from "../components/PageShell.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang?: Lang;
}
const { lang = "de" } = Astro.props;
const t = useTranslations(lang);

---

<BaseLayout lang={lang} active="about" bare>
  <PageShell>
    <Fragment slot="doodle">
      <Doodle
        name="about"
        labelA={t("about.doodleA")}
        labelB={t("about.doodleB")}
        width={260}
        height={200}
        rotate={-2}
        hoverRotate={2}
        hoverScale={1.03}
      />
    </Fragment>
    <div class="about">
      <h1>{t("about.title")}</h1>
      <p class="text">{t("about.text")}</p>
      <div class="social">
        <SocialLinks labels={{ github: t("about.github"), linkedin: t("about.linkedin"), coffee: t("about.coffee") }} />
      </div>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 640px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.1;
  }
  .text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text2);
  }
  .social {
    margin-top: 6px;
  }

  @media (max-width: 800px) {
    .about {
      gap: 20px;
      max-width: none;
    }
    h1 {
      font-size: 38px;
    }
  }
</style>
