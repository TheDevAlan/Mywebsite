---
// Startseite (6a): nur Doodle und Claim, zentriert. Routen: src/pages/index.astro (de), src/pages/en/index.astro (en)
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang?: Lang;
}
const { lang = "de" } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} bare>
  <div class="home">
    <Doodle
      name="home"
      labelA={t("home.doodleA")}
      labelB={t("home.doodleB")}
      width={400}
      height={320}
      rotate={2}
      hoverRotate={-1.5}
      hoverScale={1.02}
    />
    <p class="claim">{t("home.claim")}</p>
  </div>
</BaseLayout>

<style>
  .home {
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: 40px;
  }
  .claim {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.1;
    text-align: center;
    max-width: 520px;
    text-wrap: balance;
  }

  @media (max-width: 800px) {
    .home {
      min-height: 70vh;
      gap: 22px;
      padding: 24px 20px 40px;
    }
    .claim {
      font-size: 32px;
    }
  }
</style>
