---
// Seite "contact" (6e). Routen: src/pages/contact.astro (de), src/pages/en/contact.astro (en)
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import PageShell from "../components/PageShell.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang?: Lang;
}
const { lang = "de" } = Astro.props;
const t = useTranslations(lang);

const EMAIL = "info@alangawlik.de";
---

<BaseLayout lang={lang} active="contact" bare>
  <PageShell>
    <Fragment slot="doodle">
      <Doodle
        name="contact"
        labelA={t("contact.doodleA")}
        labelB={t("contact.doodleB")}
        width={260}
        height={200}
        rotate={3}
        hoverRotate={-2}
        hoverScale={1.03}
      />
    </Fragment>
    <h1>{t("contact.title")}</h1>
    <p class="text">{t("contact.text")}</p>
    <a class="mail" href={`mailto:${EMAIL}`}>
      <span class="marker" aria-hidden="true"></span>{EMAIL}
    </a>
    <div class="social">
      <SocialLinks labels={{ github: t("contact.github"), linkedin: t("contact.linkedin"), coffee: t("contact.coffee") }} />
    </div>
  </PageShell>
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
  }
  .text {
    margin: 0;
    max-width: 440px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text2);
    text-wrap: pretty;
  }
  .mail {
    position: relative;
    margin-top: 10px;
    padding: 0 6px;
    isolation: isolate;
    font-family: var(--font-body);
    font-size: 30px;
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s;
  }
  .mail:hover {
    transform: rotate(-1deg);
  }
  .marker {
    position: absolute;
    left: -4px;
    right: -6px;
    bottom: -2px;
    height: 16px;
    background: var(--coral-l);
    border-radius: 10px 4px 12px 6px;
    transform: rotate(-1.2deg);
    z-index: -1;
  }
  .social {
    margin-top: 22px;
  }
  .mail:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 4px;
  }

  /* Mobil: Rahmen und Doodle-Position kommen aus PageShell */
  @media (max-width: 800px) {
    h1 {
      font-size: 44px;
    }
    .mail {
      font-size: 22px;
      overflow-wrap: anywhere;
    }
    .social {
      margin-top: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mail {
      transition: none;
    }
    .mail:hover {
      transform: none;
    }
  }
</style>
