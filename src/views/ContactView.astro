---
// Seite "contact" (6e). Routen: src/pages/contact.astro (de), src/pages/en/contact.astro (en)
// Icon-Pfade stammen aus dem früheren Footer (git show main:src/components/Footer.astro).
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang?: Lang;
}
const { lang = "de" } = Astro.props;
const t = useTranslations(lang);

const EMAIL = "info@alangawlik.de";

const pills = [
  {
    href: "https://github.com/TheDevAlan",
    label: t("contact.github"),
    paths: [
      "M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z",
    ],
    circle: false,
  },
  {
    href: "https://www.linkedin.com/in/alan-gawlik-332202316/",
    label: t("contact.linkedin"),
    paths: [
      "M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z",
    ],
    circle: true,
  },
  {
    href: "https://buymeacoffee.com/TheDevAlan",
    label: t("contact.coffee"),
    paths: [
      "M5 2h2v3H5zm4 0h2v3H9zm4 0h2v3h-2zm6 7h-2V7H3v11c0 1.654 1.346 3 3 3h8c1.654 0 3-1.346 3-3h2c1.103 0 2-.897 2-2v-5c0-1.103-.897-2-2-2zm-4 9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V9h10v9zm2-2v-5h2l.002 5H17z",
    ],
    circle: false,
  },
];
---

<BaseLayout lang={lang} active="contact" bare>
  <div class="contact">
    <div class="doodle">
      <Doodle
        name="contact"
        labelA={t("contact.doodleA")}
        labelB={t("contact.doodleB")}
        width={260}
        height={200}
        rotate={3}
        hoverRotate={-2}
        hoverScale={1.03}
      />
    </div>
    <h1>{t("contact.title")}</h1>
    <p class="text">{t("contact.text")}</p>
    <a class="mail" href={`mailto:${EMAIL}`}>
      <span class="marker" aria-hidden="true"></span>{EMAIL}
    </a>
    <div class="pills">
      {
        pills.map((p) => (
          <a class="pill" href={p.href} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              {p.circle && <circle cx="4.983" cy="5.009" r="2.188" />}
              {p.paths.map((d) => (
                <path d={d} fill-rule="evenodd" clip-rule="evenodd" />
              ))}
            </svg>
            {p.label}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    position: relative;
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 22px;
    padding: 72px 72px 96px 24px;
  }
  .doodle {
    position: absolute;
    top: 64px;
    right: 80px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
  }
  .text {
    margin: 0;
    max-width: 440px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text2);
    text-wrap: pretty;
  }
  .mail {
    position: relative;
    margin-top: 10px;
    padding: 0 6px;
    isolation: isolate;
    font-family: var(--font-body);
    font-size: 30px;
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s;
  }
  .mail:hover {
    transform: rotate(-1deg);
  }
  .marker {
    position: absolute;
    left: -4px;
    right: -6px;
    bottom: -2px;
    height: 16px;
    background: var(--coral-l);
    border-radius: 10px 4px 12px 6px;
    transform: rotate(-1.2deg);
    z-index: -1;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 22px;
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 24px 8px 18px;
    border: 1.5px solid var(--ink);
    border-radius: 30px;
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .pill:hover {
    background: var(--coral-l);
    transform: rotate(-2deg);
  }
  .mail:focus-visible,
  .pill:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 4px;
  }
</style>
