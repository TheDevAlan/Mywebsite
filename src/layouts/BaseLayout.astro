---
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";

import { SITE_TITLE } from "../config";
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  /** Sprache der Seite: de (ohne Präfix) oder en (/en/...) */
  lang?: Lang;
  /** Aktiver Navigationspunkt; Startseite und Rechtliches: keiner */
  active?: "about" | "works" | "thoughts" | "contact";
  /** Sidebar bleibt beim Scrollen stehen (works) */
  stickySidebar?: boolean;
  /** Hauptspalte füllt mindestens die Viewporthöhe (Start, contact) */
  fullHeight?: boolean;
  /** Kein Standard-Padding und keine max-width: die Seite gestaltet ihre Hauptspalte selbst */
  bare?: boolean;
}

const {
  image,
  title = SITE_TITLE,
  description: descriptionProp,
  ogType,
  lang = "de",
  active,
  stickySidebar = false,
  fullHeight = false,
  bare = false,
} = Astro.props;
const description = descriptionProp ?? useTranslations(lang)("meta.description");
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
  </head>
  <body>
    <div class="layout">
      <Sidebar active={active} sticky={stickySidebar} lang={lang} />
      <main class:list={["main", { full: fullHeight, bare }]}>
        <slot />
      </main>
      <!-- Nur mobil sichtbar; am Desktop steht die Fußzeile in der Sidebar -->
      <div class="mobile-foot">
        <SiteFooter lang={lang} />
      </div>
    </div>
  </body>
</html>

<style>
  .layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    min-height: 100vh;
    /* Auf breiten Bildschirmen: Seite zentrieren statt über die ganze Breite ziehen */
    max-width: 1280px;
    margin-inline: auto;
  }
  .main {
    min-width: 0;
    padding: 72px 64px 72px 24px;
    max-width: 900px;
  }
  .main.full {
    min-height: 100vh;
  }
  .main.bare {
    padding: 0;
    max-width: none;
  }
  .mobile-foot {
    display: none;
  }

  /* Mobil: eine Spalte, Sidebar ist die Leiste oben (siehe Sidebar.astro) */
  @media (max-width: 800px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .main {
      padding: 24px 20px 48px;
      max-width: none;
    }
    .main.full {
      min-height: 0;
    }
    .main.bare {
      padding: 0;
    }
    .mobile-foot {
      display: block;
      padding: 8px 20px 32px;
    }
  }
</style>
