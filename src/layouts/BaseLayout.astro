---
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import type { Lang } from "../i18n/ui";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  /** Sprache der Seite: de (ohne Präfix) oder en (/en/...) */
  lang?: Lang;
  /** Aktiver Navigationspunkt; Startseite und Rechtliches: keiner */
  active?: "about" | "works" | "thoughts" | "contact";
  /** Sidebar bleibt beim Scrollen stehen (works) */
  stickySidebar?: boolean;
  /** Hauptspalte füllt mindestens die Viewporthöhe (Start, contact) */
  fullHeight?: boolean;
  /** Kein Standard-Padding und keine max-width: die Seite gestaltet ihre Hauptspalte selbst */
  bare?: boolean;
}

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogType,
  lang = "de",
  active,
  stickySidebar = false,
  fullHeight = false,
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  </head>
  <body>
    <div class="layout">
      <Sidebar active={active} sticky={stickySidebar} lang={lang} />
      <main class:list={["main", { full: fullHeight, bare }]}>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    min-height: 100vh;
  }
  .main {
    min-width: 0;
    padding: 72px 64px 72px 24px;
    max-width: 900px;
  }
  .main.full {
    min-height: 100vh;
  }
  .main.bare {
    padding: 0;
    max-width: none;
  }
</style>
